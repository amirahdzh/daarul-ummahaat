# Copy to /opt/daarul/.env on the VPS and fill in. Permissions must be 600. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32

# --- Site -------------------------------------------------------------------------------------
# Domain without "https://" and without "www".
DOMAIN=example.org
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.org
# Full public address, with https://
SITE_URL=https://example.org

# --- Secrets ----------------------------------------------------------------------------------
# Use hex (openssl rand -hex 24) so the password is safe inside a URL.
POSTGRES_PASSWORD=
# Signs login sessions. Changing it logs everyone out.
PAYLOAD_SECRET=

# --- Contact form -----------------------------------------------------------------------------
# Optional. Used when "Contact information" in the admin has no email yet.
CONTACT_TO_EMAIL=

# --- First administrator ----------------------------------------------------------------------
# Only used when there are no users yet. Password must be 12+ characters.
# Remove both lines after your first successful login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Backups (Cloudflare R2, via restic) --------------------------------------------------------
# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>
RESTIC_REPOSITORY=
# Encrypts the backups. Keep a copy in your password manager: without it backups cannot be restored.
RESTIC_PASSWORD=
# R2 API token (Object Read & Write, limited to the backup bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, e.g. a healthchecks.io ping URL. Alerts you when a backup does not run or fails.
HEALTHCHECK_URL=
# Retention
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
