[Unit]
Description=Run the Daarul Ummahaat backup every night

[Timer]
# 03:15 Jakarta time, whatever timezone the server itself uses.
OnCalendar=*-*-* 03:15:00 Asia/Jakarta
RandomizedDelaySec=5min
# Run at next boot if the server was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
