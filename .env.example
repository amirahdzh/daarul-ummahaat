# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/daarul_ummahaat
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Optional. Where uploaded files are stored (default: ./media). Point at a persistent volume in production.
# MEDIA_DIR=/data/media

# Public address of the site, used for canonical links, the sitemap and social sharing.
SITE_URL=http://localhost:3000
# Optional. Where contact-form messages go when Contact information has no email yet.
# CONTACT_TO_EMAIL=info@example.org
